# Copy this file to .env and fill in your real API key.
# Never commit your actual .env file — it's already covered by .gitignore.
#
# Get a free key at: https://www.exchangerate-api.com

EXCHANGE_RATE_API_KEY=your_api_key_here

# If you're using Open Exchange Rates instead, use this variable name
# in your code instead, and remove the line above.
# OPEN_EXCHANGE_RATES_APP_ID=your_app_id_here
